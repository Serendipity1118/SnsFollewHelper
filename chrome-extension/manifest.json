{
  "manifest_version": 3,
  "name": "フォロー補助（X / Instagram フォロー優先キュー）",
  "version": "0.1.0",
  "description": "存在しない・フォロー済みのX / Instagramプロフィールタブを閉じ、結果をローカルのWebサービスへ知らせます。フォローボタンは押しません。",
  "key": "",
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "background": { "service_worker": "src/background.js" },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_title": "フォロー補助（クリックで ON/OFF）", "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" } },
  "options_page": "src/options.html",
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*", "https://www.instagram.com/*"],
      "js": ["src/settings.js", "src/profileUrl.js", "src/detect.js", "src/content.js"],
      "run_at": "document_idle"
    }
  ]
}
